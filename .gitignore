.claude/
.codex/

# ============================================================
# Source data & PII — survey files, respondent data
# ============================================================
data/*.xlsx
data/*.xls
data/*.docx
data/*.doc
data/~$*          # Word/Excel temp lock files

# ============================================================
# Runtime databases & event logs — contain PII / session data
# ============================================================
data/observability.db
data/observability.db-shm
data/observability.db-wal
data/*.db
data/*.db-shm
data/*.db-wal
data/logs/


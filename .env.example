# -------------------------------
# Data Inputs And Caching
# -------------------------------
# Absolute or repo-relative path to your main survey dictionary .xlsx file.
EXCEL_SOURCE_PATH=data/market_research_capstone_draft_1.xlsx
# Directory where retriever and prompt cache artifacts are stored.
INDEX_CACHE_DIR=data/cache

# -------------------------------
# OpenAI Configuration
# -------------------------------
# Your OpenAI API key. Put your real key here (example format: sk-...).
OPENAI_API_KEY=
# Embedding model used for semantic retrieval.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Default chat model used by the UI/API.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Comma-separated models shown in the UI selector.
OPENAI_CHAT_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini,gpt-4o

# -------------------------------
# Retrieval / RAG Behavior
# -------------------------------
# true = retrieval-augmented behavior enabled; false = deterministic-only behavior.
RAG_ENABLED=true
# Minimum confidence needed before preferring retrieval-only output.
RAG_CONFIDENCE_THRESHOLD=0.72
# Minimum gap between top results used in route confidence logic.
RAG_SCORE_GAP_THRESHOLD=0.07
# TTL (seconds) for semantic embedding cache entries.
RAG_EMBED_CACHE_TTL=1800
# TTL (seconds) for answer cache entries.
RAG_ANSWER_CACHE_TTL=600
# true = allow startup batch rebuild of retrieval artifacts.
RAG_BATCH_REBUILD=true

# -------------------------------
# Observability / Logging
# -------------------------------
# SQLite file path for telemetry, traces, governance, and SLA snapshots.
OBSERVABILITY_DB_PATH=data/observability.db
# Directory for JSONL event logs.
LOGS_DIR=data/logs

# -------------------------------
# API / Routing
# -------------------------------
# Shared secret for internal API requests (set a strong random token in non-dev envs).
API_INTERNAL_TOKEN=dev-internal-token
# Optional remote API base URL for UI client (leave blank for in-process/local mode).
API_BASE_URL=
# Governance policy version label to stamp in compliance payloads.
GOVERNANCE_POLICY_VERSION=v1
# Default route mode: hybrid | llm | deterministic.
DEFAULT_ROUTER_MODE=hybrid

# -------------------------------
# Server Runtime Tuning
# -------------------------------
# Host:port binding for API server.
API_BIND=0.0.0.0:8000
# Fixed worker count (blank lets server auto-calculate).
API_WORKERS=
# Max worker cap when auto-calculating workers.
API_MAX_WORKERS=
# Threads per worker.
API_THREADS=1
# Socket backlog queue size.
API_BACKLOG=2048
# Keep-alive seconds for HTTP connections.
API_KEEPALIVE=10
# Hard request timeout in seconds.
API_TIMEOUT=60
# Graceful shutdown timeout in seconds.
API_GRACEFUL_TIMEOUT=30
# Restart worker after this many requests (memory leak protection).
API_MAX_REQUESTS=2000
# Random jitter added to max requests to stagger worker restarts.
API_MAX_REQUESTS_JITTER=250
# Logging verbosity: debug | info | warning | error.
API_LOG_LEVEL=info

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FastAPI (uvicorn dev)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["/tmp/pmg_start_api.sh"],
      "port": 8000
    },
    {
      "name": "FastAPI (gunicorn production)",
      "runtimeExecutable": "/opt/homebrew/bin/python3",
      "runtimeArgs": [
        "-m", "gunicorn",
        "-c", "src/backend/api/gunicorn_conf.py",
        "backend.api.app:app"
      ],
      "env": {
        "PYTHONPATH": "src"
      },
      "port": 8000
    },
    {
      "name": "Streamlit UI",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["/tmp/pmg_start_ui.sh"],
      "port": 8501
    }
  ]
}
